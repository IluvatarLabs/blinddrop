{
  "name": "blinddrop",
  "version": "0.5.1",
  "description": "A local encrypted vault for agent credential use",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "bin": {
    "blinddrop": "dist/cli.js"
  },
  "files": [
    "dist",
    "ui",
    "plugin",
    "README.md",
    "CLIENTS.md",
    "CONFIGURATION.md",
    "FLY.md",
    "OAUTH.md",
    "examples",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": "^22.13.0 || >=23.5.0"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build",
    "test": "npm run build && cross-env NODE_EXTRA_CA_CERTS=test/fixtures/localhost-cert.pem node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@inquirer/password": "5.2.2",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@smithy/signature-v4": "5.7.3",
    "commander": "15.0.0",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.12",
    "oauth4webapi": "3.8.8",
    "open": "11.0.3",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.125.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@smithy/types": "4.18.0",
    "@types/node": "22.20.2",
    "cross-env": "10.1.0",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IluvatarLabs/blinddrop.git"
  },
  "homepage": "https://github.com/IluvatarLabs/blinddrop#readme",
  "bugs": {
    "url": "https://github.com/IluvatarLabs/blinddrop/issues"
  }
}
